coverage/

# Environment variables
.env
.env.local
.env.*.local

# 依赖边车的本地构建产物（由 vite 构建步骤生成）
backend/build/

# 可执行文件（运行时依赖不再入库，改由边车按需下载）
*.exe
dll/

# Temporary files
*.tmp
*.temp
.cache/

