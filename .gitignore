# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules
.pnp
.pnp.js

# Build outputs
# 只排除**根目录**的 dist：写成 `dist` 会连带匹配 app/frontend/dist，
# 而那个目录不能整个消失——Wails 的 `//go:embed all:frontend/dist`
# 在目录不存在时会让 Go 包编译失败（见 app/scripts/prepare-embed-dir.sh）。
/dist
dist-ssr
dist-electron
dist-web
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Lock files - 保留以锁定依赖版本
# 如果你不想上传 lock 文件，取消下面的注释
# pnpm-lock.yaml
# package-lock.json
# yarn.lock

# Release directory (electron-builder output)
release/

# Test coverage
coverage/

# Environment variables
.env
.env.local
.env.*.local

# 依赖边车的本地构建产物（由 vite 构建步骤生成）
backend/build/

# 可执行文件（运行时依赖不再入库，改由边车按需下载）
*.exe
dll/

# Temporary files
*.tmp
*.temp
.cache/
.pnpm-store/

# OS files
Thumbs.db

# ZCode agent 本地目录
.zcode/

# TypeScript 增量构建缓存
*.tsbuildinfo
.vercel
.env*

# Docker 本地运行数据（由 docker-compose 生成）
# 锚定到仓库根：不加 `/` 时这条规则会连 `scripts/data/` 一起忽略，
# 而那里放的是来源审计的上游快照与登记表，**必须入库**（见 docs/provenance/audit.md）
/data/
docker/dist-web/
docker/dist-server/
docker/node_modules/

# 一次性 QA 脚本（本机截图/抓取用，硬编码了本机浏览器路径，不入库）
.qa/

# wails dev 生成的临时 plist（Info.plist 才需要提交）
app/build/darwin/Info.dev.plist
