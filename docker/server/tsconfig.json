{
  // 无头服务的类型检查配置（编辑器用）。
  //
  // 这里**不能**用 `moduleResolution: nodenext`：本仓库的导入一律不带扩展名
  // （与渲染进程、主进程一致），nodenext 会要求 `./update.js` 这种写法，
  // 于是整个文件树报出二十来条 TS2835 —— 这些噪音会盖住真正的类型错误。
  // 实际构建走 vite（rolldown 解析，不需要扩展名），所以用 `bundler` 与构建保持一致。
  //
  // 注意：`pnpm vue-tsc --noEmit`（CI 的类型检查）**不包含**这个目录 ——
  // 它只检查 `src/` 与 `electron/`。容器侧的类型安全靠 `pnpm test:web`
  // （跑打包产物）与 `pnpm lint:docker` 兜，见 AGENTS.md 的「容器镜像」一节。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "baseUrl": "../..",
    "paths": {
      "electron": ["./docker/server/electron-shim.ts"]
    }
  },
  "include": ["*.ts", "*.d.ts"]
}
