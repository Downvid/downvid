// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.downvid.app",
  "asar": true,
  "productName": "DownVid",
  "icon": "build/icon.png",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  // 安装包不再内置 yt-dlp / ffmpeg：只带 Go 边车，运行时识别并复用系统已安装的版本，
  // 缺失时由边车下载到 userData（见 electron/utils/runtime.ts）。
  "extraResources": [
    {
      "from": "backend/build/${platform}-${arch}",
      "to": "downvid-deps",
      "filter": ["**/*"]
    }
  ],
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "removePackageScripts": true,
  "removePackageKeywords": true,

  // ===== macOS =====
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "artifactName": "${productName}-${arch}-Mac-${version}.${ext}",
    "darkModeSupport": true,
    "identity": null
  },
  "dmg": {
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ]
  },

  // ===== Windows =====
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "ldstore.ico",
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  // 便携版需单独命名：与安装包同名会互相覆盖，导致 latest.yml 校验失败、自动更新中断
  "portable": {
    "artifactName": "${productName}-Portable-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "./ldstore.ico",
    "uninstallerIcon": "./ldstore.ico"
  },

  // ===== Linux =====
  "linux": {
    "target": ["AppImage", "deb", "rpm", "tar.gz"],
    "artifactName": "${productName}-${arch}-Linux-${version}.${ext}",
    "category": "Utility",
    // electron-builder 26 起 .desktop 条目需放在 desktop.entry 下
    "desktop": {
      "entry": {
        "Name": "DownVid",
        "Comment": "全平台视频下载工具",
        "Categories": "Utility;AudioVideo;Network;"
      }
    }
  },

  // ===== Auto Update =====
  "publish": {
    "provider": "github",
    "owner": "yxxbc",
    "repo": "downvid",
    "releaseType": "release"
  }
}
