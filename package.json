{
  "name": "downvid",
  "private": true,
  "version": "1.6.4",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@11.0.0",
  "description": "现代化的开源跨平台视频下载工具 — 一键保存全网无水印高清视频 / A modern, cross-platform open-source video downloader GUI",
  "keywords": [
    "video-downloader",
    "yt-dlp",
    "video-download",
    "media-downloader",
    "youtube-downloader",
    "bilibili-downloader",
    "douyin-downloader",
    "kuaishou-downloader",
    "electron",
    "vue3",
    "desktop-app",
    "cross-platform",
    "ffmpeg",
    "aria2",
    "download-manager",
    "视频下载器",
    "无水印下载"
  ],
  "author": "DownVid <downvid@example.com>",
  "scripts": {
    "dev": "vite",
    "demo:ui": "pnpm --dir app/frontend demo",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:real": "node scripts/test-e2e-real.mjs",
    "lint:boundaries": "node scripts/lint-boundaries.mjs",
    "sync:repo": "node scripts/sync-repo-coords.mjs --check",
    "sync:toolchain": "node scripts/sync-toolchain-versions.mjs",
    "gen:contributors": "node scripts/gen-contributors.mjs",
    "lint:attribution": "node scripts/lint-attribution.mjs",
    "deps:manifest": "node scripts/gen-deps-manifest.mjs",
    "deps:manifest:check": "node scripts/gen-deps-manifest.mjs --check",
    "lint:icons": "node scripts/lint-icons.mjs",
    "lint:website": "node scripts/lint-website.mjs",
    "lint:docs": "node scripts/lint-docs.mjs",
    "audit:provenance": "node scripts/audit-provenance.mjs",
    "test:issue:triage": "node scripts/test-issue-triage.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "website:version": "node scripts/sync-website-version.mjs",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "check:frontend": "pnpm --dir app/frontend check",
    "lint:i18n:app": "node scripts/lint-frontend-i18n.mjs",
    "sync:changelog": "node scripts/sync-changelog.mjs --check",
    "lint:website:preview": "node scripts/check-website-preview.mjs"
  },
  "dependencies": {
    "@material-symbols/font-400": "^0.48.0",
    "bufferutil": "^4.1.0",
    "marked": "^18.1.1",
    "pinia": "^4.1.0",
    "puppeteer-core": "^25.14.0",
    "utf-8-validate": "^6.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "main": "dist-electron/main.js",
  "pnpm": {
    "onlyBuiltDependencies": [
      "bufferutil",
      "electron",
      "esbuild",
      "utf-8-validate"
    ]
  }
}
